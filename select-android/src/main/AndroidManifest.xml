<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <provider android:authorities="com.infinifolder.documents" />
        <package android:name="com.infinifolder" />
    </queries>
    <application>
        <activity
            android:name="io.github.gretchycat.infiniselect.FileSelectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/InfiniSelect.TransparentActivity" />
        <provider
            android:name="io.github.gretchycat.infiniselect.SelectionDocumentProvider"
            android:authorities="${applicationId}.infiniselect.documents"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
